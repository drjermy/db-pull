{
    "name": "drjermy/db-pull",
    "description": "Pull production databases locally with automatic sanitization",
    "type": "library",
    "keywords": [
        "laravel",
        "database",
        "mysql",
        "postgres",
        "dump",
        "sanitize",
        "anonymize",
        "gdpr",
        "artisan"
    ],
    "homepage": "https://github.com/drjermy/db-pull",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Jones",
            "email": "jeremy@jonesonthe.net"
        }
    ],
    "support": {
        "issues": "https://github.com/drjermy/db-pull/issues",
        "source": "https://github.com/drjermy/db-pull"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "laravel/prompts": "^0.1 || ^0.2 || ^0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "DrJermy\\DbPull\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrJermy\\DbPull\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DrJermy\\DbPull\\DbPullServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
